# Скопируйте в .env.
# По умолчанию SQLite — запускается без PostgreSQL.
DATABASE_URL=sqlite+pysqlite:///./data/app.db

# PostgreSQL (если есть база):
# DATABASE_URL=postgresql+psycopg://ntec:<ПАРОЛЬ>@127.0.0.1:5432/ntec

# --- Оборудование и планшеты ---
DETECTOR=board
LAYOUT_PATH=../ar_board/out_real/layout.json
GAUGE_CONFIG=configs/manometer_board.json
ALIGN_MODE=features
ALIGN_REFERENCES=../ar_board/references.json

# --- Визуальные каналы ---
CV_DEFECTS=true
ANOMALY_ENABLED=true
ANOMALY_DEVICE=cpu
ANOMALY_MODEL_DIR=../anomaly/v2/models
ANOMALY_THRESHOLD_FACTOR=2.5
CORROSION_ENABLED=true
CORROSION_PROVIDERS=cpu
CORROSION_MODEL_PATH=../corrosion/models/corrosion_yolo11n_640.onnx
CORROSION_CONF=0.25

# --- Правила и телеметрия ---
RULE_ACTIVATE_CONFIDENCE=0.65
RULE_RELEASE_CONFIDENCE=0.45
CV_TTL_SEC=5
SIM_ENABLED=true
SIM_TICK_SEC=1.0
SIM_RUNTIME_HOURS_PER_SEC=0.02
TELEMETRY_RETENTION_MIN=180

# --- Локальная VLM (Ollama, офлайн) ---
VISION_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
