{
  "meta": {
    "name": "KST Energy Engineering — Industrial Inspector Design Tokens",
    "version": "1.0.0",
    "date": "2026-11-14",
    "description": "Токены дизайн-системы мобильного помощника инженера. Тёмная тема — основная. Все контрасты посчитаны по WCAG 2.1.",
    "source": "https://kst-energo.ru",
    "wcag": {
      "textAA": 4.5,
      "largeTextAA": 3.0,
      "graphicsAA": 3.0
    },
    "flutterNote": "Значения color.*.argb готовы для Color(0xAARRGGBB). Шрифты — системные: fontFamily не задавать (Roboto на Android, SF Pro на iOS)."
  },

  "color": {
    "brand": {
      "900": { "hex": "#063E61", "argb": "0xFF063E61", "use": "глубокая брендовая подложка", "textSafe": false },
      "800": { "hex": "#082544", "argb": "0xFF082544", "use": "самый тёмный брендовый фон (вход/сплэш)", "textSafe": false },
      "600": { "hex": "#135AA6", "argb": "0xFF135AA6", "use": "ядро бренда: заливка primary-кнопки, логотип, светлая тема", "textSafe": true, "onColor": "#FFFFFF", "contrastOnColor": 6.91 },
      "300": { "hex": "#4C9EEA", "argb": "0xFF4C9EEA", "use": "интерактивный синий тёмной темы: текст, иконки, фокус", "textSafe": true, "contrastOnBg": 6.76, "contrastOnSurface": 6.1 },
      "tint": { "hex": "#0F2135", "argb": "0xFF0F2135", "use": "подложка брендового бейджа/выделения", "textSafe": true, "contrastWith300": 5.73 }
    },

    "secondary": {
      "400": { "hex": "#35B8E0", "argb": "0xFF35B8E0", "use": "живые данные, телеметрия, графики (тёмная тема)", "textSafe": true, "contrastOnBg": 8.31 },
      "700": { "hex": "#0B6E8A", "argb": "0xFF0B6E8A", "use": "живые данные (светлая тема)", "textSafe": true, "contrastOnWhite": 5.81 }
    },

    "neutralDark": {
      "950": { "hex": "#0B0F14", "argb": "0xFF0B0F14", "use": "фон приложения" },
      "900": { "hex": "#141B23", "argb": "0xFF141B23", "use": "поверхность карточки" },
      "850": { "hex": "#1C2630", "argb": "0xFF1C2630", "use": "поверхность над карточкой: шит, поле ввода, чип" },
      "700": { "hex": "#2E3A47", "argb": "0xFF2E3A47", "use": "декоративная граница, разделитель", "contrastOnBg": 1.66, "note": "не использовать как границу управляющего элемента" },
      "600": { "hex": "#55697E", "argb": "0xFF55697E", "use": "сильная граница, обводка secondary-кнопки, фокус", "contrastOnBg": 3.39, "contrastOnSurface": 3.06 },
      "400": { "hex": "#8595A6", "argb": "0xFF8595A6", "use": "приглушённый текст, подписи, «нет данных»", "contrastOnBg": 6.27, "contrastOnSurface": 5.65 },
      "300": { "hex": "#A9B8C7", "argb": "0xFFA9B8C7", "use": "вторичный текст", "contrastOnBg": 9.49, "contrastOnSurface": 8.56 },
      "100": { "hex": "#F2F5F8", "argb": "0xFFF2F5F8", "use": "основной текст", "contrastOnBg": 17.56, "contrastOnSurface": 15.85 }
    },

    "semanticDark": {
      "ok": {
        "text": { "hex": "#3DD68C", "argb": "0xFF3DD68C", "contrastOnBg": 10.25, "contrastOnSurface": 9.25 },
        "tint": { "hex": "#0E2A1D", "argb": "0xFF0E2A1D", "contrastWithText": 8.19 },
        "onFill": { "hex": "#0B0F14", "argb": "0xFF0B0F14", "contrastOnFill": 10.25 },
        "shape": "circle-check",
        "label": "Норма",
        "icon": "check"
      },
      "warn": {
        "text": { "hex": "#FFC53D", "argb": "0xFFFFC53D", "contrastOnBg": 12.18, "contrastOnSurface": 10.99 },
        "tint": { "hex": "#3A2E0A", "argb": "0xFF3A2E0A", "contrastWithText": 8.45 },
        "onFill": { "hex": "#0B0F14", "argb": "0xFF0B0F14", "contrastOnFill": 12.18 },
        "shape": "triangle",
        "label": "Внимание",
        "icon": "warning"
      },
      "defect": {
        "text": { "hex": "#FF6B6B", "argb": "0xFFFF6B6B", "contrastOnBg": 6.93, "contrastOnSurface": 6.25 },
        "tint": { "hex": "#3A1416", "argb": "0xFF3A1416", "contrastWithText": 5.86 },
        "onFill": { "hex": "#0B0F14", "argb": "0xFF0B0F14", "contrastOnFill": 6.93 },
        "surface": { "hex": "#1A1215", "argb": "0xFF1A1215", "use": "фон плашки дефекта" },
        "shape": "diamond",
        "label": "Дефект",
        "icon": "error"
      },
      "nodata": {
        "text": { "hex": "#8B99A6", "argb": "0xFF8B99A6", "contrastOnBg": 6.59, "contrastOnSurface": 5.95 },
        "tint": { "hex": "#1E242B", "argb": "0xFF1E242B", "contrastWithText": 5.1 },
        "onFill": { "hex": "#0B0F14", "argb": "0xFF0B0F14", "contrastOnFill": 6.59 },
        "shape": "dashed-circle",
        "label": "Нет данных",
        "icon": "help"
      }
    },

    "action": {
      "primary": { "hex": "#135AA6", "argb": "0xFF135AA6", "pressed": "#0F4A88", "disabled": "#1C2630", "disabledText": "#55697E", "text": "#FFFFFF", "contrast": 6.91 },
      "secondary": { "hex": "transparent", "border": "#55697E", "borderPressed": "#4C9EEA", "text": "#F2F5F8", "borderContrast": 3.39 },
      "danger": { "hex": "#C0323A", "argb": "0xFFC0323A", "pressed": "#A0262D", "disabled": "#3A1416", "text": "#FFFFFF", "contrast": 5.59 },
      "dangerText": { "hex": "#FF8A8F", "argb": "0xFFFF8A8F", "contrastOnBg": 8.5 },
      "dangerTint": { "hex": "#3A1416", "argb": "0xFF3A1416", "contrastWithText": 7.19 }
    },

    "light": {
      "bg": { "hex": "#F4F6F8", "argb": "0xFFF4F6F8" },
      "surface": { "hex": "#FFFFFF", "argb": "0xFFFFFFFF" },
      "surfaceAlt": { "hex": "#E8EDF2", "argb": "0xFFE8EDF2" },
      "border": { "hex": "#C9D3DD", "argb": "0xFFC9D3DD", "contrastOnWhite": 1.52, "note": "декор" },
      "text": { "hex": "#14181C", "argb": "0xFF14181C", "contrastOnWhite": 17.84 },
      "textSecondary": { "hex": "#3F4C59", "argb": "0xFF3F4C59", "contrastOnWhite": 8.79 },
      "textMuted": { "hex": "#5C6B7A", "argb": "0xFF5C6B7A", "contrastOnWhite": 5.47 },
      "brand": { "hex": "#135AA6", "argb": "0xFF135AA6", "contrastOnWhite": 6.91 },
      "secondary": { "hex": "#0B6E8A", "argb": "0xFF0B6E8A", "contrastOnWhite": 5.81 },
      "ok": { "hex": "#137A4B", "argb": "0xFF137A4B", "contrastOnWhite": 5.37 },
      "warn": { "hex": "#8A5A00", "argb": "0xFF8A5A00", "contrastOnWhite": 5.93 },
      "defect": { "hex": "#B4232A", "argb": "0xFFB4232A", "contrastOnWhite": 6.53 },
      "nodata": { "hex": "#5C6B7A", "argb": "0xFF5C6B7A", "contrastOnWhite": 5.47 }
    },

    "overlay": {
      "arStatusBar": { "hex": "#0B0F14", "alpha": 0.55, "use": "фон строки статуса AR" },
      "arPanelTop": { "hex": "#0B0F14", "alpha": 0.0, "use": "верх градиента панели" },
      "arPanelMid": { "hex": "#0B0F14", "alpha": 0.55, "use": "середина градиента" },
      "arPanelBottom": { "hex": "#0B0F14", "alpha": 0.92, "use": "низ градиента панели" },
      "scrim": { "hex": "#000000", "alpha": 0.35, "use": "подложка под прогресс/модалку" }
    }
  },

  "typography": {
    "family": {
      "android": "Roboto (system)",
      "ios": "SF Pro Text / SF Pro Display (system)",
      "flutterFontFamily": null,
      "note": "Внешние шрифты не подключаются. Числа — tabularFigures."
    },
    "minSize": 12,
    "scale": {
      "display": { "size": 40, "height": 44, "lineHeight": 1.1, "weight": 800, "letterSpacing": -1.0, "use": "число-метрика героя" },
      "metric": { "size": 28, "height": 32, "lineHeight": 1.14, "weight": 800, "letterSpacing": -0.5, "use": "крупное число в карточке" },
      "h1": { "size": 24, "height": 28, "lineHeight": 1.17, "weight": 700, "letterSpacing": -0.3, "use": "имя оборудования, заголовок экрана" },
      "h2": { "size": 20, "height": 26, "lineHeight": 1.3, "weight": 700, "letterSpacing": -0.2, "use": "заголовок секции, пустое состояние" },
      "title": { "size": 17, "height": 24, "lineHeight": 1.41, "weight": 600, "letterSpacing": 0, "use": "название узла, заголовок карточки" },
      "body": { "size": 16, "height": 22, "lineHeight": 1.375, "weight": 400, "letterSpacing": 0, "use": "основной текст, evidence" },
      "bodyStrong": { "size": 16, "height": 22, "lineHeight": 1.375, "weight": 600, "letterSpacing": 0, "use": "рекомендация, значение" },
      "label": { "size": 14, "height": 18, "lineHeight": 1.29, "weight": 600, "letterSpacing": 0.1, "use": "подпись метрики, кнопка 2-го уровня, бейдж" },
      "caption": { "size": 12, "height": 16, "lineHeight": 1.33, "weight": 500, "letterSpacing": 0.2, "use": "единицы, служебные подписи, строка статуса AR" },
      "overline": { "size": 12, "height": 16, "lineHeight": 1.33, "weight": 700, "letterSpacing": 0.6, "use": "НАДЗАГОЛОВОК КАПСОМ, максимум 1 на экран", "uppercase": true }
    },
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "numeric": { "fontFeatures": ["tabularFigures"], "use": "все числа, обновляющиеся в реальном времени" }
  },

  "spacing": {
    "unit": 4,
    "scale": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "6": 24,
      "8": 32
    },
    "semantic": {
      "screenPadding": 16,
      "cardPadding": 16,
      "gapInline": 8,
      "gapBlock": 12,
      "gapCard": 24,
      "sectionGap": 32,
      "listDivider": 1
    }
  },

  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "full": 999,
    "use": {
      "badge": 8,
      "chip": 999,
      "button": 12,
      "input": 12,
      "card": 16,
      "diagnosticCard": 16,
      "sheet": 24,
      "fab": 999
    }
  },

  "size": {
    "touchMin": 48,
    "buttonPrimary": 56,
    "buttonSecondary": 48,
    "buttonDanger": 48,
    "rowNode": 64,
    "rowListMin": 56,
    "badgeHeight": 28,
    "badgeHeightLarge": 32,
    "chipHeight": 40,
    "chipHeightAr": 44,
    "inputHeight": 52,
    "arStatusRow": 28,
    "arStatusRowHit": 48,
    "arPanelCollapsed": 96,
    "arPanelMaxRatio": 0.45,
    "arShutter": 64,
    "iconSm": 16,
    "iconMd": 20,
    "iconLg": 24,
    "iconEmpty": 48,
    "divider": 1,
    "focusRing": 2,
    "borderWidth": 1,
    "borderWidthStrong": 1.5
  },

  "elevation": {
    "dark": {
      "mode": "borders",
      "shadows": "none",
      "levels": {
        "0": { "surface": "#0B0F14", "border": null },
        "1": { "surface": "#141B23", "border": "#2E3A47" },
        "2": { "surface": "#1C2630", "border": "#2E3A47" }
      },
      "note": "Тени на тёмном фоне не видны и загрязняют экран в цеху. Глубина — только цветом поверхности и границей."
    },
    "light": {
      "mode": "shadow",
      "levels": {
        "0": { "surface": "#F4F6F8", "shadow": null },
        "1": { "surface": "#FFFFFF", "shadow": "0 1px 2px rgba(20,24,28,0.06)" },
        "2": { "surface": "#FFFFFF", "shadow": "0 8px 24px rgba(20,24,28,0.12)" }
      },
      "note": "Тень только для шита и модальных окон."
    }
  },

  "motion": {
    "duration": {
      "fast": 120,
      "normal": 200,
      "slow": 320,
      "skeletonPulse": 1200
    },
    "curve": {
      "standard": "easeInOutCubic",
      "enter": "easeOutCubic",
      "exit": "easeInCubic"
    },
    "rules": {
      "decorativeAnimation": "запрещена",
      "allowed": ["пульсация скелетона", "мигание неподтверждённой аварии", "появление/скрытие нижнего шита"],
      "reduceMotion": "уважать MediaQuery.disableAnimations"
    }
  },

  "components": {
    "statusBadge": {
      "height": 28,
      "heightLarge": 32,
      "paddingH": 10,
      "paddingV": 4,
      "radius": 8,
      "borderWidth": 1,
      "borderAlpha": 0.55,
      "iconSize": 14,
      "iconGap": 6,
      "textStyle": "label",
      "maxPerRow": 2,
      "states": {
        "ok": { "text": "#3DD68C", "bg": "#0E2A1D", "label": "Норма", "shape": "circle-check" },
        "warn": { "text": "#FFC53D", "bg": "#3A2E0A", "label": "Внимание", "shape": "triangle" },
        "defect": { "text": "#FF6B6B", "bg": "#3A1416", "label": "Дефект", "shape": "diamond" },
        "nodata": { "text": "#8B99A6", "bg": "#1E242B", "label": "Нет данных", "shape": "dashed-circle", "borderStyle": "dashed" }
      }
    },

    "nodeRow": {
      "height": 64,
      "paddingLeft": 16,
      "paddingRight": 12,
      "paddingV": 12,
      "radius": 12,
      "bg": "#141B23",
      "divider": "#2E3A47",
      "statusBar": { "width": 4, "height": 40, "radius": 2 },
      "title": { "style": "title", "maxLines": 2 },
      "meta": { "style": "caption", "color": "#8595A6", "maxLines": 1 },
      "chevron": { "size": 18, "color": "#55697E" }
    },

    "equipmentCard": {
      "padding": 16,
      "radius": 16,
      "bg": "#141B23",
      "border": "#2E3A47",
      "title": { "style": "h1", "maxLines": 2 },
      "subtitle": { "style": "caption", "color": "#8595A6", "maxLines": 1 },
      "badgePosition": "top-right",
      "metricsMax": 2,
      "metricGap": 12,
      "dividerGap": 16,
      "problem": { "labelStyle": "overline", "bodyStyle": "body", "maxLines": 1 },
      "recommendation": { "labelStyle": "overline", "bodyStyle": "bodyStrong", "maxLines": 2 },
      "action": { "type": "secondary", "height": 48, "fullWidth": true },
      "order": ["status", "identity", "metrics", "problem", "recommendation", "action"]
    },

    "diagnosticCard": {
      "padding": 16,
      "paddingLeftWithStripe": 12,
      "radius": 16,
      "bg": "#141B23",
      "bgDefect": "#1A1215",
      "severityStripe": { "width": 4, "fullHeight": true },
      "header": { "style": "overline", "nodeStyle": "title", "maxLines": 1 },
      "evidence": { "style": "body", "color": "#A9B8C7", "maxLines": 2, "requiresNumber": true },
      "recommendation": { "style": "bodyStrong", "prefix": "→", "maxLines": 2, "startsWithVerb": true },
      "meta": { "style": "caption", "color": "#8595A6", "maxLines": 1 },
      "link": { "style": "label", "color": "#4C9EEA", "hitHeight": 48 },
      "maxVisible": 2
    },

    "arStatusRow": {
      "height": 28,
      "hitHeight": 48,
      "marginTop": 6,
      "marginH": 8,
      "paddingH": 8,
      "radius": 8,
      "bg": "rgba(11,15,20,0.55)",
      "dot": { "size": 8, "gap": 6 },
      "text": { "style": "caption", "weight": 600, "maxLines": 1, "overflow": "ellipsis" },
      "dotColors": {
        "live": "#3DD68C",
        "connecting": "#35B8E0",
        "reconnecting": "#FFC53D",
        "offline": "#FF6B6B"
      },
      "maxWords": 6,
      "trailingActions": ["journal"]
    },

    "arBottomPanel": {
      "collapsedHeight": 96,
      "maxHeightRatio": 0.45,
      "radiusTop": 24,
      "paddingH": 12,
      "paddingTop": 4,
      "paddingBottom": 12,
      "grip": { "width": 32, "height": 4, "radius": 2, "color": "#55697E" },
      "gradient": {
        "colors": ["rgba(11,15,20,0.0)", "rgba(11,15,20,0.55)", "rgba(11,15,20,0.92)"],
        "stops": [0.0, 0.35, 1.0]
      },
      "collapsed": { "statusLine": 1, "plates": 0, "actions": 1 },
      "expanded": { "statusLine": 1, "platesMax": 2, "overflowLink": true, "actions": 1 },
      "primaryAction": { "label": "Завершить осмотр", "height": 56, "style": "primary" },
      "forbidden": ["telemetry", "ocr", "analytics", "zoneChips", "secondaryButtons"]
    },

    "buttons": {
      "primary": { "height": 56, "radius": 12, "bg": "#135AA6", "text": "#FFFFFF", "textStyle": "body", "weight": 700, "pressed": "#0F4A88", "disabledBg": "#1C2630", "disabledText": "#55697E", "maxPerScreen": 1 },
      "secondary": { "height": 48, "radius": 12, "bg": "transparent", "border": "#55697E", "borderWidth": 1.5, "text": "#F2F5F8", "textStyle": "body", "weight": 600, "pressedBg": "#1C2630", "disabledBorder": "#2E3A47", "disabledText": "#55697E" },
      "danger": { "height": 48, "radius": 12, "bg": "#C0323A", "text": "#FFFFFF", "textStyle": "body", "weight": 600, "pressed": "#A0262D", "disabledBg": "#3A1416", "disabledText": "#8595A6", "requiresConfirmation": true },
      "focusRing": { "width": 2, "color": "#4C9EEA", "offset": 2 },
      "iconSize": 20,
      "iconGap": 8
    },

    "metricTile": {
      "height": 76,
      "padding": 12,
      "radius": 12,
      "bg": "#1C2630",
      "label": { "style": "overline", "color": "#8595A6" },
      "value": { "style": "metric" },
      "unit": { "style": "caption", "color": "#8595A6", "inline": true }
    },

    "emptyState": {
      "iconSize": 48,
      "iconColor": "#55697E",
      "titleStyle": "h2",
      "bodyStyle": "body",
      "bodyColor": "#A9B8C7",
      "bodyMaxLines": 2,
      "actionsCount": 1,
      "align": "center",
      "paddingH": 32
    },

    "errorState": {
      "iconSize": 48,
      "iconColorWarn": "#FFC53D",
      "iconColorDefect": "#FF6B6B",
      "titleStyle": "h2",
      "bodyMaxLines": 2,
      "mustStateDataPreserved": true,
      "primaryAction": "Повторить",
      "secondaryAction": "Работать офлайн",
      "inline": { "height": 48, "bg": "#3A2E0A", "border": "rgba(255,197,61,0.6)", "textStyle": "label" }
    },

    "chip": {
      "height": 40,
      "heightAr": 44,
      "radius": 999,
      "paddingH": 12,
      "bg": "#1C2630",
      "border": "#2E3A47",
      "text": "#F2F5F8",
      "textStyle": "label",
      "selectedBg": "#0F2135",
      "selectedBorder": "#4C9EEA",
      "selectedText": "#4C9EEA"
    }
  },

  "screens": {
    "maxWordsWithoutScroll": 60,
    "maxDepth": 3,
    "ar": {
      "statusRowWords": 6,
      "centerFreeRatio": 0.5,
      "maxInteractive": 2,
      "collapsedWords": 12
    },
    "card": {
      "maxBlocks": 6,
      "maxLinesPerBlock": 3,
      "metrics": 2
    },
    "listRow": { "maxLines": 2 }
  },

  "accessibility": {
    "minTextSize": 12,
    "minTouchTarget": 48,
    "contrastText": 4.5,
    "contrastLargeText": 3.0,
    "contrastGraphics": 3.0,
    "statusEncoding": ["color", "shape", "text"],
    "screenReader": "Semantics для каждого статуса: label = «Связь: в эфире», «Узел: подшипник, дефект»",
    "reduceMotion": true,
    "supportTextScale": [1.0, 1.3],
    "note": "При textScale 1.3 вёрстка не должна обрезать числа и статусы; проверять на 360×640 dp."
  }
}
